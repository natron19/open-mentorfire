<div style="max-width: 720px;">
  <%= form_with model: mentor_offer,
        data: { controller: "form-submit", action: "submit->form-submit#disable" } do |f| %>

    <% if mentor_offer.errors.any? %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% mentor_offer.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="mb-3">
      <%= f.label :subject, "Subject", class: "form-label" %>
      <%= f.text_field :subject, maxlength: 120,
            class: "form-control #{'is-invalid' if mentor_offer.errors[:subject].any?}",
            placeholder: "What you could mentor someone in, the way people here would say it" %>
      <% if mentor_offer.errors[:subject].any? %>
        <div class="invalid-feedback"><%= mentor_offer.errors[:subject].first %></div>
      <% end %>
    </div>

    <div class="mb-3">
      <%= f.label :experience, "What you have actually done", class: "form-label" %>
      <%= f.text_area :experience, rows: 7, maxlength: 2500,
            class: "form-control #{'is-invalid' if mentor_offer.errors[:experience].any?}",
            placeholder: "The years, the jobs, the bad days and what you learned from them. In your own words." %>
      <div class="form-text">
        The draft is built only from what you write here, so the moments matter more than titles. Leave out other
        people's names.
      </div>
      <% if mentor_offer.errors[:experience].any? %>
        <div class="invalid-feedback"><%= mentor_offer.errors[:experience].first %></div>
      <% end %>
    </div>

    <div class="mb-3">
      <%= f.label :who_its_for, "Who it is for", class: "form-label" %>
      <%= f.text_area :who_its_for, rows: 3, maxlength: 600,
            class: "form-control #{'is-invalid' if mentor_offer.errors[:who_its_for].any?}",
            placeholder: "The kind of person who would ask you, and where they are starting from" %>
      <% if mentor_offer.errors[:who_its_for].any? %>
        <div class="invalid-feedback"><%= mentor_offer.errors[:who_its_for].first %></div>
      <% end %>
    </div>

    <div class="row g-3 mb-4">
      <div class="col-sm-6">
        <%= f.label :sessions_count, "Number of sessions", class: "form-label" %>
        <%= f.select :sessions_count,
              MentorOffer::SESSION_COUNTS.map { |n| [ "#{n} sessions", n ] },
              {}, class: "form-select #{'is-invalid' if mentor_offer.errors[:sessions_count].any?}" %>
        <% if mentor_offer.errors[:sessions_count].any? %>
          <div class="invalid-feedback"><%= mentor_offer.errors[:sessions_count].first %></div>
        <% end %>
      </div>
      <div class="col-sm-6">
        <%= f.label :session_minutes, "Session length", class: "form-label" %>
        <%= f.select :session_minutes,
              MentorOffer::SESSION_LENGTHS.map { |m| [ "#{m} minutes", m ] },
              {}, class: "form-select #{'is-invalid' if mentor_offer.errors[:session_minutes].any?}" %>
        <% if mentor_offer.errors[:session_minutes].any? %>
          <div class="invalid-feedback"><%= mentor_offer.errors[:session_minutes].first %></div>
        <% end %>
      </div>
      <div class="col-12 form-text mt-1">Every mentorship ends. The Program will have exactly this many sessions.</div>
    </div>

    <%= f.submit mentor_offer.new_record? ? "Save offer" : "Save changes", class: "btn btn-primary", data: { form_submit_target: "button" } %>
  <% end %>
</div>
