<div class="d-flex justify-content-between align-items-start mb-3 gap-3">
  <div>
    <h1 class="h3 mb-1"><%= @mentor_offer.subject %></h1>
    <p class="text-muted small mb-0">
      <%= link_to "← What I could mentor", mentor_offers_path, class: "text-muted" %>
      &nbsp;&middot;&nbsp; <%= @mentor_offer.shape_label %>
    </p>
  </div>
  <div class="d-flex gap-2 flex-shrink-0">
    <%= link_to "Edit", edit_mentor_offer_path(@mentor_offer), class: "btn btn-outline-secondary btn-sm" %>
    <%= button_to "Delete", mentor_offer_path(@mentor_offer),
          method: :delete,
          form: { data: { turbo_confirm: "Delete this offer and its Program drafts?" } },
          class: "btn btn-outline-danger btn-sm" %>
  </div>
</div>

<div class="card mb-4" style="max-width: 820px;">
  <div class="card-body">
    <p class="text-muted small mb-1">What I have actually done</p>
    <p class="offer-text mb-3"><%= @mentor_offer.experience %></p>
    <dl class="row mb-0 small">
      <dt class="col-sm-4 text-muted">Who it is for</dt>
      <dd class="col-sm-8"><%= @mentor_offer.who_its_for %></dd>
      <dt class="col-sm-4 text-muted">Sessions</dt>
      <dd class="col-sm-8 mb-0"><%= @mentor_offer.shape_label %></dd>
    </dl>
  </div>
</div>

<div class="mb-4" style="max-width: 820px;">
  <%= render "mentor_offers/draft_button", mentor_offer: @mentor_offer, label: "Draft my Program", button_class: "btn btn-primary" %>
  <p class="text-muted small mt-2 mb-0">
    The draft reads only what you wrote above, never your name or email. It builds exactly
    <%= @mentor_offer.sessions_count %> sessions, each with an agenda that fits in <%= @mentor_offer.session_minutes %>
    minutes, starter tasks for you or your mentee, and three questions for a first intro. It never judges whether you
    or anyone else is suited to this. Typically takes 15&ndash;40 seconds.
  </p>
</div>

<% if @program_drafts.any? %>
  <h2 class="h6 text-muted mb-2">Earlier drafts</h2>
  <ul class="list-unstyled small" style="max-width: 820px;">
    <% @program_drafts.each do |draft| %>
      <li class="mb-2">
        <%= link_to mentor_offer_program_draft_path(@mentor_offer, draft) do %>
          <%= draft.generated_at ? "#{time_ago_in_words(draft.generated_at)} ago" : "Unknown time" %>
        <% end %>
        &nbsp;
        <% if draft.completed? %>
          <span class="badge program-badge"><%= draft.name.truncate(60) %></span>
        <% else %>
          <span class="text-muted fst-italic"><%= draft.failed? ? "could not be used" : "still running" %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
